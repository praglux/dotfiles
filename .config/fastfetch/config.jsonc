{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": { 
	    "type": "file", 
	    "source": "~/.config/fastfetch/logo.txt", 
	    "padding": {
		    "right": 3
	} },
	
    "display": {
        "separator": "  ",

        "key": {
            "width": 14,
            "type": "string",
            "paddingLeft": 0
        },

        "color": {
            "keys": "default",
            "output": "default",
            "separator": "default"
        },

        "brightColor": true
    },

    "modules": [

        {
            "type": "title",
            "key": "󰀄 user",
            "keyColor": "red"
        },

        {
            "type": "uptime",
            "key": "󰅐 uptime",
            "keyColor": "yellow"
        },

        {
            "type": "display",
            "key": "󰍹 display",
            "keyColor": "green"
        },

        {
            "type": "os",
            "key": "󰣇 distro",
            "keyColor": "cyan"
        },

        {
            "type": "kernel",
            "key": "󰒋 kernel",
            "keyColor": "magenta"
        },

        {
            "type": "wm",
            "key": "󰖯 wm",
            "keyColor": "green"
        },

        {
            "type": "terminal",
            "key": " term",
            "keyColor": "red"
        },

        {
            "type": "packages",
            "key": "󰏖 apps",
            "keyColor": "yellow"
        },

        {
            "type": "disk",
            "key": "󰋊 disk",
            "keyColor": "cyan"
        },

        {
            "type": "memory",
            "key": "󰍛 memory",
            "keyColor": "green"
        },

        {
            "type": "command",
            "key": "󰅐 os age",
            "keyColor": "yellow",

            "text": "install=$(stat -c %W / 2>/dev/null); if [ \"$install\" -gt 0 ]; then echo \"$(( ($(date +%s) - install) / 86400 )) days\"; elif [ -d /var/log/installer ]; then install=$(stat -c %Y /var/log/installer 2>/dev/null); echo \"$(( ($(date +%s) - install) / 86400 )) days\"; else echo \"unknown\"; fi"
        },

        "break",

        {
            "type": "colors",
            "symbol": "circle",
            "paddingLeft": 0
        }
    ]
}
